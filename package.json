{
  "name": "weis-tiny-adventures",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "wordpress:start": "node scripts/start-wordpress.mjs",
    "wordpress:stop": "docker compose down",
    "test:wordpress": "node scripts/test-wordpress.mjs",
    "test:wordpress:scroll": "node scripts/test-wordpress-scroll.mjs",
    "wordpress:assets": "node scripts/build-wordpress.mjs",
    "wordpress:build": "node scripts/build-wordpress.mjs && vite build --config wordpress/weis-travel-tools/vite.config.mjs",
    "legacy:dev": "npm --prefix legacy-app run dev",
    "legacy:build": "npm --prefix legacy-app run build",
    "legacy:preview": "npm --prefix legacy-app run preview",
    "legacy:start": "npm --prefix legacy-app start"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "d3-geo": "^3.1.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "topojson-client": "^3.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@vitejs/plugin-react": "6.1.1",
    "sharp": "^0.35.4",
    "vite": "8.3.0"
  }
}
