# For local development, leave SITE_URL unset to use the browser's current origin.
# Production requires your public HTTPS origin, also used for unsubscribe links.
# SITE_URL=https://your-travel-blog.example

# Private SQLite storage. Use a mounted persistent directory in production.
NEWSLETTER_DATA_DIR=./data

# npm start binds locally by default; a container may need HOST=0.0.0.0.
HOST=127.0.0.1
PORT=3000

# Optional: exact socket IP of one trusted reverse proxy that overwrites/appends
# X-Forwarded-For with the real client address. Leave unset for direct hosting.
# TRUST_PROXY_IP=127.0.0.1
